# axisml-platform-backend Makefile
#
# Platform is the user-facing aggregator. cmd/platform-backend runs the
# serve / migrate / bootstrap cobra commands and the real HTTP API (Auth /
# Users / Tenants / Quotas / Members wired today; the remaining contract
# surface returns 501 until its handlers land). The full API is declared as Go
# DTOs in internal/server and rendered to axisml-platform/docs/apis/platform.yaml by
# cmd/openapi-gen; the System-layer clients are generated by `make client-gen`.
# The build/image/test/doc contract matches the sibling services.

IMAGE_REPO ?= ghcr.io/axisml/axisml-platform-backend
# Must track axisml-system/deploy/helm Chart.appVersion (the Helm template
# defaults image.tag to .Chart.AppVersion when unset).
IMAGE_TAG  ?= 0.1.0
IMAGE      := $(IMAGE_REPO):$(IMAGE_TAG)

BIN_NAME  ?= axisml-platform-backend
CMD_PATH  ?= ./cmd/platform-backend
REPO_ROOT := $(abspath $(CURDIR)/../..)

.DEFAULT_GOAL := build

.PHONY: help build test image image-load-minikube clean fmt vet tidy

help: ## Show this help
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-22s\033[0m %s\n", $$1, $$2}'

build: ## Compile the platform-backend binary into bin/
	@CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o bin/$(BIN_NAME) $(CMD_PATH)

test: ## Run unit tests
	@go test ./...

image: ## Build the container image ($(IMAGE)) using repo root as build context
	@docker build -f $(CURDIR)/Dockerfile -t $(IMAGE) $(REPO_ROOT)

image-load-minikube: image ## Build and load the image into the local minikube node
	@minikube image load $(IMAGE)

clean: ## Remove build artifacts
	@rm -rf bin/ coverage/

fmt: ## go fmt ./...
	@go fmt ./...

vet: ## go vet ./...
	@go vet ./...

tidy: ## go mod tidy
	@go mod tidy

# --- System-layer typed clients (generated) ---
#
# The cluster-manager / compute / artifacts clients are GENERATED from the
# downstream OpenAPI specs in axisml-system/docs/apis via oapi-codegen, landing under
# internal/clients/<service>/generated/. Never hand-edit the *.gen.go files;
# re-run `make client-gen` after a downstream spec changes.

OAPI_CODEGEN ?= go run github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@v2.4.1
SPEC_DIR     := $(REPO_ROOT)/axisml-system/docs/apis

.PHONY: client-gen
client-gen: ## Regenerate the System-layer typed clients from axisml-system/docs/apis specs
	@$(OAPI_CODEGEN) -config internal/clients/clustermanager/generated/oapi-codegen.yaml  $(SPEC_DIR)/cluster-manager.yaml
	@$(OAPI_CODEGEN) -config internal/clients/computeservice/generated/oapi-codegen.yaml  $(SPEC_DIR)/compute-service.yaml
	@$(OAPI_CODEGEN) -config internal/clients/artifacthub/generated/oapi-codegen.yaml     $(SPEC_DIR)/artifact-hub.yaml
	@go mod tidy

# --- OpenAPI ---
#
# Regenerates axisml-platform/docs/apis/platform.yaml from the Go DTO structs in
# internal/server. The generator lives at cmd/openapi-gen and shares its
# reflection engine with the other API services via pkg/openapigen.

OPENAPI_OUT ?= $(REPO_ROOT)/axisml-platform/docs/apis/platform.yaml

.PHONY: doc-gen doc-test
doc-gen: ## Regenerate $(OPENAPI_OUT) from the Go DTO types
	@go run ./cmd/openapi-gen -o $(OPENAPI_OUT) -version $(IMAGE_TAG)

doc-test: ## Fail if $(OPENAPI_OUT) is out of date with the Go types (CI guard)
	@$(MAKE) --no-print-directory doc-gen
	@if ! git -C $(REPO_ROOT) diff --quiet -- $(OPENAPI_OUT); then \
	  echo "ERROR: $(OPENAPI_OUT) is out of date. Run 'make doc-gen' and commit the result."; \
	  git -C $(REPO_ROOT) --no-pager diff -- $(OPENAPI_OUT); \
	  exit 1; \
	fi

# --- Integration tests ---
#
# Platform's integration suite drives the in-process gin engine via httptest
# (no envtest / testcontainers needed — it has no K8s client or DB yet).

MODULE_PATH := github.com/axisml/axisml/components/platform

.PHONY: integration integration-coverage
integration: ## Run integration tests (in-process httptest)
	@cd test/integration && go test -tags=integration -count=1 -timeout=10m ./...

integration-coverage: ## Run integration tests with a coverage profile
	@mkdir -p $(COVERAGE_DIR)
	@cd test/integration && \
	  go test -tags=integration -count=1 -timeout=10m \
	    -coverpkg=$(MODULE_PATH)/... \
	    -coverprofile=$(COVERAGE_DIR)/integration-coverage.out -covermode=atomic ./...

# --- Coverage ---

COVERAGE_DIR  ?= $(CURDIR)/coverage
COVERAGE_OUT  ?= $(COVERAGE_DIR)/coverage.out
COVERAGE_HTML ?= $(COVERAGE_DIR)/coverage.html

.PHONY: coverage coverage-html
coverage: ## Run unit tests with a coverage profile
	@mkdir -p $(COVERAGE_DIR)
	@go test -coverprofile=$(COVERAGE_OUT) -covermode=atomic -count=1 ./...

coverage-html: ## Render the unit coverage profile to HTML
	@if [ -f $(COVERAGE_OUT) ]; then \
	  go tool cover -html=$(COVERAGE_OUT) -o $(COVERAGE_HTML); \
	  echo "unit coverage: $(COVERAGE_HTML)"; \
	fi
